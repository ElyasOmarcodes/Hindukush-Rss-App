.idea/
.vscode/
*.iml
.DS_Store

# Symbols from obfuscated release builds
/build/symbols/

# Never commit private signing keys — they live in GitHub Actions Secrets.
signing/*.p12
signing/*.pfx
signing/*.jks
signing/*.keystore
signing/*.base64


# Python
__pycache__/
*.pyc
